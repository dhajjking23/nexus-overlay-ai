# NEXUS OVERLAY AI - Environment Configuration
# Copy to .env and fill in values

# AI Provider Key (OpenRouter - free tier available)
# Get key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional: OpenAI direct (paid)
OPENAI_API_KEY=

# Optional: Anthropic (paid)
ANTHROPIC_API_KEY=

# Transport
TRANSPORT_HOST=0.0.0.0
TRANSPORT_PORT=8765
HTTP_BRIDGE_PORT=8766
HEALTH_PORT=8767

# Database
DATABASE_PATH=./data/nexus_overlay.db

# Logging
LOG_LEVEL=INFO

# Security (CHANGE THESE!)
AUTH_TOKEN=
SECRET_KEY=
